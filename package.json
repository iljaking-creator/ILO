{
  "name": "@ilo/higgsfield-connector",
  "version": "0.1.0",
  "description": "Connector for the Higgsfield AI generation API (image & video) for ILO.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "higgsfield-mcp": "dist/mcp-server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "example": "node --import tsx src/example.ts",
    "mcp": "node --import tsx src/mcp-server.ts",
    "generate": "node --import tsx src/generate-clips.ts",
    "serve": "node --import tsx scripts/serve.ts",
    "start:server": "node --import tsx src/platform/server/index.ts",
    "ingest": "node --import tsx src/platform/kb/ingest.ts",
    "test": "node --import tsx --test src/platform/tests/*.test.ts"
  },
  "keywords": [
    "higgsfield",
    "connector",
    "ai",
    "image-generation",
    "video-generation",
    "ilo"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "@hono/node-server": "^1.13.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@supabase/supabase-js": "^2.45.0",
    "hono": "^4.6.0",
    "imapflow": "^1.0.171",
    "mailparser": "^3.7.1",
    "nodemailer": "^6.9.15",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.5",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.16",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
