# Higgsfield API credentials.
# Create a key pair at https://cloud.higgsfield.ai and paste it below.
# Format: KEY_ID:KEY_SECRET
HF_CREDENTIALS=

# Optional overrides
# HIGGSFIELD_BASE_URL=https://platform.higgsfield.ai


# ============================================================================
# K&I Kundenwerke – KI-Kundenservice-Plattform (src/platform)
# Alles optional: ohne Keys läuft der Demo-Modus, mit nur ANTHROPIC_API_KEY
# der "anthropic-only"-Modus, mit Supabase der "live"-Modus.
# ============================================================================

# LLM (Claude). Ohne Key -> Demo-Modus (Antworten aus lokaler Seed-FAQ).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8
# ANTHROPIC_MODEL_CHEAP=claude-sonnet-4-6

# Datenhaltung (Supabase, EU-Region empfohlen). Ohne -> In-Memory.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Wissensbasis. Ohne URL -> Platzhalter-FAQ. Voyage = optionale semantische Suche.
COMPANY_SITE_URL=
VOYAGE_API_KEY=

# Kanäle (alle optional, „add token to go live")
TELEGRAM_BOT_TOKEN=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Server
PORT=8787
WEB_ALLOWED_ORIGINS=*
RATE_LIMIT_PER_MIN=20
DATA_RETENTION_DAYS=90
